        "mainEntity": [
          {
            "@type": "Question",
            "name": "Qu’est-ce que le GEO ?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "L’optimisation pour les moteurs génératifs : rendre un site compréhensible et citable par des assistants comme ChatGPT, Gemini ou Perplexity."
            }
          },
          {
            "@type": "Question",
            "name": "Le GEO remplace-t-il le SEO ?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Non. Il s’appuie dessus. Un site rapide et bien structuré reste la base, voir notre page SEO."
            }
          },
          {
            "@type": "Question",
            "name": "Pouvez-vous garantir que je serai cité ?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Non. Les assistants choisissent leurs sources eux-mêmes. Nous travaillons ce qui les aide à vous comprendre."
            }
          },
          {
            "@type": "Question",
            "name": "À quoi sert un fichier llms.txt ?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "C’est une proposition de standard qui résume un site pour les modèles de langage. Il ne remplace ni le contenu ni les données structurées."
            }
          },
          {
            "@type": "Question",
            "name": "Quels assistants suivez-vous ?",
            "acceptedAnswer": {
