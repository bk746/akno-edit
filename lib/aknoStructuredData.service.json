        "mainEntity": [
          {
            "@type": "Question",
            "name": "Garantissez-vous la première position ?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Non. Personne ne contrôle l’algorithme de Google. Nous nous engageons sur ce qui se maîtrise : technique, vitesse, contenu et suivi."
            }
          },
          {
            "@type": "Question",
            "name": "Quand voit-on des effets ?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Le SEO se construit dans la durée. Chaque point de suivi montre l’évolution, sans chiffre promis à l’avance."
            }
          },
          {
            "@type": "Question",
            "name": "Le SEO est-il inclus dans un site AKNO ?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Oui pour les bases : technique, structure et Core Web Vitals font partie du livrable."
            }
          },
          {
            "@type": "Question",
            "name": "Travaillez-vous sur un site existant ?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Oui. On commence par un audit, puis on corrige ce qui freine."
            }
          },
          {
            "@type": "Question",
            "name": "Quelle différence avec le GEO ?",
            "acceptedAnswer": {
              "@type": "Answer",
              "text": "Le SEO vise les résultats de Google. Le GEO vise les réponses des assistants IA. Les deux se renforcent."
            }
